DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=replicahub
# Este servicio realiza envíos REALES. No existe modo DRY_RUN.
# Misma clave AES-256-GCM que se configura en backend/.env
REPEATER_ENCRYPTION_KEY=PEGAR_LA_MISMA_CLAVE_HEX_DE_64_CARACTERES
# Si se inicia un cursor nuevo, revisar las últimas 24 horas de posiciones
DISPATCHER_BACKFILL_MINUTES=1440
# URL HTTPS aprobada del destino (también declarada en backend)
SUTRAN_ENDPOINT_URL=https://URL_REAL_DEL_ENDPOINT_SUTRAN
TZ=UTC
