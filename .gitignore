# ==========================================
# ReplicaHub - Git Ignore
# ==========================================

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Node dependencies
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/
out/
**/out/

# Compiled builds
dist/
**/dist/
build/
**/build/

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage / cache
coverage/
**/coverage/
.cache/
**/.cache/
*.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp
*.zip

# Editors
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# PM2
.pm2/